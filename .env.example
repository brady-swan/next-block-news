ANTHROPIC_API_KEY=
# NBN_MODEL=claude-opus-5
# NBN_TRIAGE_MODEL=claude-opus-5
NBN_POLL_SECONDS=120
NBN_AUTOPOST_ENABLED=false
# Optional X read access - the wire's OWN key, never the Marketing Node's
NBN_X_BEARER_TOKEN=

# Perception feed (1,000+ outlets) - the wire's OWN key from perception.to, never the Node's
NBN_PERCEPTION_API_KEY=
NBN_PERCEPTION_POLL_SECONDS=600
# Autopost classes: primary (official sources) + corroborated (2+ independent outlets).
# "secondary" (single-outlet press) is code-hardened to never auto-post.
NBN_AUTOPOST_CLASSES=primary,corroborated

# Typefully (PREFERRED rail: long posts + threads + publish-now; API key from Typefully settings)
# Get social_set_id: curl -H "Authorization: Bearer $KEY" https://api.typefully.com/v2/social-sets
TYPEFULLY_API_KEY=
TYPEFULLY_SOCIAL_SET_ID=
