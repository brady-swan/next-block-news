ANTHROPIC_API_KEY=
NBN_MODEL=claude-sonnet-5
NBN_TRIAGE_MODEL=claude-sonnet-5
NBN_TRIAGE_EFFORT=medium
NBN_EDITOR_MODEL=claude-sonnet-5
NBN_EDITOR_EFFORT=medium
NBN_MAX_LLM_CALLS_PER_HOUR=60

# One fresh Sonnet context owns each complete intake batch. Roll out in order:
# off (legacy), shadow (compare only), draft (real gates/Typefully drafts), live.
NBN_RUN_NEWSROOM_MODE=off
NBN_RUN_NEWSROOM_FALLBACK=legacy
NBN_RUN_NEWSROOM_MAX_ROUNDS=6
NBN_RUN_NEWSROOM_RETRY_ALLOWANCE=1
NBN_RUN_NEWSROOM_MAX_TOOL_CALLS=24
NBN_RUN_NEWSROOM_MAX_SEARCHES=8
NBN_RUN_NEWSROOM_MAX_FETCHES=16
NBN_RUN_NEWSROOM_MAX_FETCH_CHARS=8000
NBN_RUN_NEWSROOM_MAX_FETCH_TOTAL_CHARS=160000
NBN_RUN_NEWSROOM_MAX_INITIAL_BYTES=98304
NBN_RUN_NEWSROOM_MAX_HISTORY_BYTES=491520
NBN_RUN_NEWSROOM_TIMEOUT_SECONDS=240

# Cost-control rollout around the Sonnet desk. Assignment preparation first runs in observe,
# then enforce; every prep failure advances rather than suppressing a lead.
NBN_DESK_PREP_MODE=off
NBN_DESK_PREP_MODEL=claude-haiku-4-5
NBN_DESK_PREP_BATCH_SIZE=25
NBN_DESK_PREP_MAX_CALLS_PER_HOUR=6
NBN_COMPACT_DESK_ENABLED=false
NBN_COMPACT_DESK_INITIAL_BYTES=65536
NBN_COMPACT_DESK_HISTORY_BYTES=196608
NBN_DESK_PREFETCH_MAX_URLS=6
NBN_DESK_PREFETCH_MAX_CHARS=24000
NBN_DESK_PREFETCH_RESERVE_FETCHES=8
NBN_DESK_PREFETCH_RESERVE_CHARS=80000

# Sonnet may assign one narrow reporting job; Haiku's memo is context, never evidence.
NBN_HAIKU_RESEARCH_MODE=off
NBN_HAIKU_RESEARCH_MODEL=claude-haiku-4-5
NBN_HAIKU_RESEARCH_MAX_ASSIGNMENTS=1
NBN_HAIKU_RESEARCH_MAX_ROUNDS=2
NBN_HAIKU_RESEARCH_MAX_TOOL_CALLS=8
NBN_HAIKU_RESEARCH_MAX_SEARCHES=3
NBN_HAIKU_RESEARCH_MAX_FETCHES=5
NBN_HAIKU_RESEARCH_MAX_FETCH_CHARS=20000
NBN_MODEL_DAILY_TARGET_USD=6

# Cheap semantic cleanup for every RSS and SEC EDGAR card. Start in observe, inspect the
# Desk routes, then switch to enforce. Every error fails open to the Sonnet desk.
NBN_INTAKE_TRIAGE_MODE=off
NBN_INTAKE_TRIAGE_MODEL=claude-haiku-4-5
NBN_INTAKE_TRIAGE_MAX_CALLS_PER_HOUR=8
NBN_INTAKE_TRIAGE_BATCH_SIZE=50
NBN_INTAKE_TRIAGE_RECOVERY_LIMIT=100
NBN_INTAKE_TRIAGE_RECOVERY_HOURS=24
NBN_INTAKE_TRIAGE_MAX_PACKET_BYTES=98304
NBN_INTAKE_TRIAGE_TIMEOUT_SECONDS=45
NBN_INTAKE_TRIAGE_MAX_OUTPUT_TOKENS=8000

# Model-free Google organic discovery. Search results are pointers, never evidence.
SERPAPI_KEY=
NBN_SERPAPI_TIMEOUT_SECONDS=15
NBN_SERPAPI_MAX_RESULTS=5
NBN_SEARCH_RESILIENCE_ENABLED=false
NBN_SEARCH_ACCOUNT_TTL_SECONDS=300
NBN_SEARCH_CACHE_TTL_SECONDS=3600
NBN_SEARCH_POINTER_TTL_SECONDS=21600
NBN_SEARCH_PROVIDER_COOLDOWN_SECONDS=300
NBN_DESK_CLUSTER_COMPANIONS_ENABLED=false
# Temporary last-resort fallback after direct links and SerpAPI are exhausted.
NBN_HOSTED_SEARCH_ENABLED=true
NBN_HOSTED_SEARCH_TIMEOUT_SECONDS=45
NBN_YIELD_IDENTITY_NORMALIZER_ENABLED=false

NBN_POLL_SECONDS=60
NBN_MAX_ITEMS_PER_TRIAGE=25
NBN_MAX_AGE_HOURS_ACTIVE=2.5
NBN_MAX_AGE_HOURS_QUIET=6
NBN_AUTOPOST_ENABLED=false
# Autopost classes are still subordinate to the editor and master kill switch.
NBN_AUTOPOST_CLASSES=primary,corroborated
NBN_PUBLISH_DELAY_SECONDS=30
NBN_PUBLISH_RECONCILE_SECONDS=300

# Source ladder. Code default is enforce. During a rollout, observe computes and records
# decisions but forces every output to DRAFT/TAPE even if autopost is accidentally on.
NBN_SOURCE_POLICY_MODE=enforce
NBN_SOURCE_EVIDENCE_LOOKBACK_HOURS=24
NBN_SOURCE_RESOLUTION_CACHE_SECONDS=3600
NBN_CYCLE_LEASE_SECONDS=900

# Typefully (preferred rail: long posts, threads, scheduled publishing)
# Get social_set_id: curl -H "Authorization: Bearer $KEY" https://api.typefully.com/v2/social-sets
TYPEFULLY_API_KEY=
TYPEFULLY_SOCIAL_SET_ID=

# X reads. The deployed bearer is shared with the Marketing Node; preserve since_id
# behavior in nbn/sources.py to avoid rebilled reads.
NBN_X_BEARER_TOKEN=
NBN_X_POLL_SECONDS=180
NBN_X_LIST_ID=
NBN_X_LIST_REFRESH_SECONDS=3600
NBN_X_DETECTOR_ENABLED=true

# Perception /feed. The deployed key is shared with the Marketing Node, so both workers
# consume one account budget.
NBN_PERCEPTION_API_KEY=
NBN_PERCEPTION_POLL_SECONDS=900
NBN_PERCEPTION_DIRECT_ENABLED=true

# Read-only Marketing Node brief used for the weekday Blocks.
NBN_NODE_BASE_URL=https://swan-marketing-node-production.up.railway.app
NBN_NODE_READ_TOKEN=
NBN_NODE_PULSE_MAX_AGE_SECONDS=10800
# Fresh EIC citations enter one-off intake; legacy multi-story Blocks stay off.
NBN_EIC_DISCOVERY_ENABLED=true
NBN_EIC_DISCOVERY_UTC=14:40,Morning;21:15,Afternoon
NBN_BRIEFING_ENABLED=false
NBN_BRIEFING_UTC=14:40,Morning;21:15,Afternoon

NBN_AUDIT_UTC=09:00
NBN_REPORT_TOKEN=
NBN_HEARTBEAT_URL=
