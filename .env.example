ANTHROPIC_API_KEY=
NBN_MODEL=claude-sonnet-5
NBN_TRIAGE_MODEL=claude-sonnet-5
NBN_EDITOR_MODEL=claude-fable-5
NBN_EDITOR_EFFORT=low
NBN_MAX_LLM_CALLS_PER_HOUR=60

NBN_POLL_SECONDS=60
NBN_MAX_ITEMS_PER_TRIAGE=25
NBN_MAX_AGE_HOURS_ACTIVE=2.5
NBN_MAX_AGE_HOURS_QUIET=6
NBN_AUTOPOST_ENABLED=false
# Autopost classes: primary (official sources) + corroborated (2+ independent outlets).
# "secondary" (single-outlet press) is code-hardened to never auto-post.
NBN_AUTOPOST_CLASSES=primary,corroborated
NBN_PUBLISH_DELAY_SECONDS=30

# Typefully (preferred rail: long posts, threads, scheduled publishing)
# Get social_set_id: curl -H "Authorization: Bearer $KEY" https://api.typefully.com/v2/social-sets
TYPEFULLY_API_KEY=
TYPEFULLY_SOCIAL_SET_ID=

# X reads. The deployed bearer is shared with the Marketing Node; preserve since_id
# behavior in nbn/sources.py to avoid rebilled reads.
NBN_X_BEARER_TOKEN=
NBN_X_POLL_SECONDS=180
NBN_X_LIST_ID=
NBN_X_LIST_REFRESH_SECONDS=3600

# Perception /feed. The deployed key is shared with the Marketing Node, so both workers
# consume one account budget.
NBN_PERCEPTION_API_KEY=
NBN_PERCEPTION_POLL_SECONDS=900

# Read-only Marketing Node brief used for the weekday Blocks.
NBN_NODE_BASE_URL=https://swan-marketing-node-production.up.railway.app
NBN_NODE_READ_TOKEN=
NBN_BRIEFING_ENABLED=true
NBN_BRIEFING_UTC=14:40,Morning;21:15,Afternoon

NBN_AUDIT_UTC=09:00
NBN_REPORT_TOKEN=
NBN_HEARTBEAT_URL=
